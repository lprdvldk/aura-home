# Copy to .env in the repo root. Never commit a real .env.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Pi device-reader ingest (never put this in the desktop app)
SMART_HOUSE_AGENT_TOKEN=change-me-to-a-long-random-token
SMART_HOUSE_REQUIRE_AGENT_TOKEN=true

# Desktop / browser telemetry when the hub is on the public internet
SMART_HOUSE_VIEWER_TOKEN=change-me-viewer-token
# SMART_HOUSE_REQUIRE_VIEWER_TOKEN=true
# SMART_HOUSE_CLOUD_MODE=true

# TLS — required for cloud_mode (HTTP/WSS and gRPC)
# SMART_HOUSE_TLS_CERTFILE=certs/hub.crt
# SMART_HOUSE_TLS_KEYFILE=certs/hub.key
# SMART_HOUSE_TLS_CA=certs/hub.crt

SMART_HOUSE_HOUSE_CONFIG=config/house.json
SMART_HOUSE_DATA_DIR=data/users
SMART_HOUSE_HTTP_HOST=0.0.0.0
SMART_HOUSE_HTTP_PORT=18443
SMART_HOUSE_GRPC_HOST=0.0.0.0
SMART_HOUSE_GRPC_PORT=18551
SMART_HOUSE_CORS_ORIGINS=http://127.0.0.1:18443,http://localhost:18443
SMART_HOUSE_SESSION_HOURS=12
SMART_HOUSE_GRPC_TARGET=127.0.0.1:18551
